<Window x:Class="EquipmentAccounting.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Учет оборудования" Height="680" Width="1100" MinHeight="520" MinWidth="820"
        WindowStartupLocation="CenterScreen" Background="#F4F6F8">
    <Window.Resources>
        <Style TargetType="Button">
            <Setter Property="Padding" Value="12,7"/><Setter Property="Margin" Value="3"/>
            <Setter Property="Background" Value="#245C9A"/><Setter Property="Foreground" Value="White"/>
            <Setter Property="BorderThickness" Value="0"/><Setter Property="Cursor" Value="Hand"/>
        </Style>
    </Window.Resources>
    <DockPanel>
        <StatusBar DockPanel.Dock="Bottom" Background="#E8EDF2">
            <TextBlock x:Name="StatusText" Text="Готово"/>
            <Separator/>
            <TextBlock x:Name="CountText"/>
            <Separator/>
            <TextBlock x:Name="TotalText" Foreground="#18705A"/>
        </StatusBar>
        <StackPanel DockPanel.Dock="Top">
            <Menu Background="White">
                <MenuItem Header="Файл">
                    <MenuItem Header="Обновить список" Click="Refresh_Click"/>
                    <Separator/>
                    <MenuItem Header="Выход" Click="Exit_Click"/>
                </MenuItem>
                <MenuItem Header="Оборудование">
                    <MenuItem Header="Добавить…" Click="Add_Click"/>
                    <MenuItem Header="Редактировать выбранное…" Click="Edit_Click"/>
                    <MenuItem Header="Удалить выбранное" Click="Delete_Click"/>
                    <Separator/>
                    <MenuItem Header="Переместить…" Click="Move_Click"/>
                </MenuItem>
                <MenuItem Header="Журналы">
                    <MenuItem Header="Ремонты выбранного оборудования" Click="Repairs_Click"/>
                    <MenuItem Header="Осмотры выбранного оборудования" Click="Inspection_Click"/>
                    <MenuItem Header="Перемещения выбранного оборудования" Click="Movements_Click"/>
                    <MenuItem Header="Инвентаризационная ведомость" Click="Inventory_Click"/>
                    <Separator/>
                    <MenuItem Header="Оптимизация поиска…" Click="Optimization_Click"/>
                    <Separator/>
                    <MenuItem Header="Отладка и исключения (ПР №10–11, Вар. 4)…" Click="Diagnostics_Click"/>
                </MenuItem>
                <MenuItem Header="Справка" Click="About_Click"/>
            </Menu>
            <ToolBarTray Background="#EEF2F6">
                <ToolBar>
                    <Button Content="Добавить" Click="Add_Click"/>
                    <Button Content="Изменить" Click="Edit_Click" Background="#466B91"/>
                    <Button Content="Удалить" Click="Delete_Click" Background="#A64747"/>
                    <Separator/>
                    <Button Content="Переместить" Click="Move_Click" Background="#466B91"/>
                    <Button Content="Ведомость" Click="Inventory_Click" Background="#18705A"/>
                    <Button Content="Отладка (Вар. 4)" Click="Diagnostics_Click" Background="#245C9A"/>
                </ToolBar>
            </ToolBarTray>
            <DockPanel Margin="20,12,20,8">
                <StackPanel DockPanel.Dock="Left" Margin="0,0,18,0">
                    <TextBlock Text="Учет оборудования предприятия" FontSize="24" FontWeight="SemiBold" Foreground="#17324D"/>
                    <TextBlock Text="Рабочее представление оборудования" Foreground="#627487" Margin="0,3,0,0"/>
                </StackPanel>
                <TextBox x:Name="SearchBox" Height="34" VerticalContentAlignment="Center" Padding="8"
                         ToolTip="Поиск по названию или инвентарному номеру" TextChanged="SearchBox_TextChanged"/>
            </DockPanel>
        </StackPanel>
        <TabControl Margin="18,0,18,14" Background="White">
            <TabItem Header="Оборудование">
                <DataGrid x:Name="EquipmentGrid" AutoGenerateColumns="False" IsReadOnly="True" CanUserAddRows="False"
                          SelectionMode="Single" SelectionUnit="FullRow" Background="White" BorderThickness="0"
                          GridLinesVisibility="Horizontal" AlternatingRowBackground="#F7FAFD" RowHeight="36"
                          SelectionChanged="EquipmentGrid_SelectionChanged">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="ID" Binding="{Binding Id}" Width="55"/>
                        <DataGridTextColumn Header="Название" Binding="{Binding Name}" Width="*" MinWidth="140"/>
                        <DataGridTextColumn Header="Инв. номер" Binding="{Binding InventoryNumber}" Width="120"/>
                        <DataGridTextColumn Header="Производитель" Binding="{Binding Manufacturer}" Width="140"/>
                        <DataGridTextColumn Header="Дата покупки" Binding="{Binding PurchaseDate, StringFormat=dd.MM.yyyy}" Width="120"/>
                        <DataGridTextColumn Header="Стоимость" Binding="{Binding Cost, StringFormat=N2}" Width="120"/>
                        <DataGridTextColumn Header="Подразделение" Binding="{Binding Department}" Width="140"/>
                    </DataGrid.Columns>
                </DataGrid>
            </TabItem>
        </TabControl>
    </DockPanel>
</Window>
